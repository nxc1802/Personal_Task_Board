# ==============================================================================
# Personal Task Board Environment Configuration (V1 Release Configuration)
# ==============================================================================

# --- 1. Neo4j Single-Store Configuration (Authoritative Store + Graphiti Memory) ---
# Kết nối tới Neo4j Community cục bộ (mặc định bind 127.0.0.1)
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change_me_in_production
NEO4J_DATABASE=neo4j

# --- 2. Service Host & Port Bindings (All Localhost 127.0.0.1 Defaults) ---
# Application REST API Service
APP_HOST=127.0.0.1
APP_PORT=8000

# FastMCP Read-Only SSE Server
MCP_HOST=127.0.0.1
MCP_PORT=8001

# OpenWebUI Local Interface
OPENWEBUI_PORT=3000

# --- 3. LLM & Embedding Provider Configuration ---
# Dùng cho Layer 2 Structured Extraction, Layer 3 Graphiti Memory & Layer 4 Explanation.
# Hỗ trợ OpenAI-compatible gateway, OpenAI, Gemini hoặc Ollama local (http://127.0.0.1:11434/v1).
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1

# Embedding Provider (Local Qwen3-Embedding-0.6B via llama.cpp)
# llama.cpp chạy GGUF Q8_0, expose OpenAI-compatible /v1/embeddings endpoint.
# Cần khởi động: llama serve -hf Qwen/Qwen3-Embedding-0.6B-GGUF:Q8_0 --embedding --pooling last --port 8082
EMBEDDING_BASE_URL=http://127.0.0.1:8082/v1
EMBEDDING_API_KEY=local
EMBEDDING_MODEL=qwen3-embedding-0.6b

# Provider-specific API keys (tùy chọn theo provider sử dụng, không hard-code secret thật)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- 4. Layer 1 Acquisition & Playwright Session Configuration ---
# Đường dẫn lưu session state sau khi chạy `ptb login microsoft`
PTB_STORAGE_STATE=data/playwright/storage_state.json

# External Ticket Trackers (tùy chọn khi bật Jira / Shortcut trong config/sources.yaml)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=user@example.com
JIRA_API_TOKEN=
JIRA_JQL=

SHORTCUT_API_TOKEN=
SHORTCUT_BASE_URL=https://api.app.shortcut.com/api/v3
SHORTCUT_QUERY=

# --- 5. Multi-Tenant & Workspace Settings ---
TENANT_ID=local-user
WORKSPACE_ID=local-workspace-001
CURRENT_USER_NAME=Local User
