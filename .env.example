# ==============================================================================
# Personal Task Board Environment Configuration
# ==============================================================================

# --- Supabase Configuration (Operational Source of Truth) ---
# Lấy từ Project Settings -> API & Database trên Supabase Dashboard
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Chuỗi kết nối PostgreSQL trực tiếp (Dùng cho migration / worker backend)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres
DATABASE_SECRET_KEY=generate-a-32-character-secret-key-for-pgcrypto-encryption

# --- Neo4j Configuration (Temporal GraphRAG Memory) ---
# Sử dụng Neo4j Aura Cloud hoặc container cục bộ qua docker-compose
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=personal_task_board_secret_2026
NEO4J_DATABASE=neo4j

# --- LLM API Configuration (OpenAI-compatible) ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-api-key
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1

# --- Service Ports & General Config ---
API_PORT=8000
WEB_PORT=3000
WORKSPACE_ID=00000000-0000-0000-0000-000000000001
CURRENT_USER_ID=00000000-0000-0000-0000-000000000002
