# ==============================================================================
# Personal Task Board Environment Configuration (Local-First Lean Edition)
# ==============================================================================

# --- Neo4j Single-Store Configuration (Operational Board + Graphiti Memory) ---
# Kết nối tới container Neo4j Community cục bộ khởi chạy qua docker-compose
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=personal_task_board_secret_2026
NEO4J_DATABASE=neo4j

# --- LLM API Configuration (OpenAI-compatible / Ollama Local) ---
# Dùng cho Layer 2 Structured Extraction và Layer 4 Grounded Explanation
# Ví dụ Ollama local: http://localhost:11434/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b
LLM_TEMPERATURE=0.1

# --- Layer 1 Acquisition Configuration ---
# Đường dẫn lưu session cookie của Playwright
PLAYWRIGHT_STORAGE_PATH=data/playwright/storage_state.json

# --- Service Ports & General Config ---
MCP_PORT=8000
OPENWEBUI_PORT=3000
WORKSPACE_ID=local-workspace-001
CURRENT_USER_NAME=Nguyen Cuong
